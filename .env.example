# kblog 环境变量示例 / kblog environment example
# 复制为 .env 后按需修改 / copy to .env and edit as needed:
#   cp .env.example .env
# 未设置的键会走 src/config.rs 里的内置默认值
# Any key left unset falls back to the default hardcoded in src/config.rs

# 监听地址 / bind address
WEB_ADDR=127.0.0.1

# 监听端口 / bind port
WEB_PORT=3000

# 模板目录 / template directory
TEMPLATES_PATH=templates

# 静态目录, 由 fallback 直接提供 / static directory, served by the fallback
ASSETS_PATH=assets

# SQLite 数据文件, 不存在时自动创建 / SQLite file, created on demand
DATABASE_PATH=data/data.db

# 后台路径前缀, 即 /{ADMIN_PATH}/login / admin prefix, i.e. /{ADMIN_PATH}/login
# 规则 rules: 非空 non-empty, ≤64 字节 bytes, 仅 ASCII 字母数字与 - _ only,
# 不得与公开路径 blog / thinking / about 冲突 must not collide with those
ADMIN_PATH=admin
